      "Workflow(fix-until-green)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npx vitest run)",
      "Bash(npx vitest run *)",
