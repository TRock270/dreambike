# Copy to .env.local. Do not put real values in this example.
# Read MODEL_API_KEY only in server-only modules or local Python scripts.
MODEL_API_KEY=
MUSE_MODEL=muse-spark-1.3-contributor

# Safe default: cached demo only. Local UI work uses MOCK=1.
LIVE_API_ENABLED=false
MOCK=0
COMPOSITE_ENABLED=true
REFERENCE_MODE_ENABLED=true
SEARCH_ENABLED=false
VOICE_ENABLED=false

# Required before enabling live calls. No NEXT_PUBLIC_ secrets.
# APP_ORIGIN is the only accepted POST origin on a deployment. An https origin also
# makes the session cookie Secure.
APP_ORIGIN=http://localhost:3000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# VISITOR_HASH_SECRET: at least 32 random bytes. It signs the session cookie and hashes
# visitor and IP buckets. Required for live calls. Without it, local development
# uses a random per-process key (cookies reset on restart); a deployment refuses POSTs.
VISITOR_HASH_SECRET=
PRICING_VERIFIED_AT=
# Maximum billable search queries within one grounded Spark request.
# Leave blank until U06 in SPEC.md has a proven bound.
SEARCH_QUERY_RESERVE=

# USD caps; accounting uses integer microdollars. Day is America/New_York.
# Environment values can only lower the SPEC 13 defaults: project 100, daily 5,
# development stop 50. Visitor and ticket caps cannot exceed the daily cap. The IP
# bucket uses the visitor caps and limits. A malformed value turns live mode off.
# The ledger also stores the project and daily caps (python spike/ledger.py set-caps);
# the smaller of the stored and the environment value applies, and live calls stop
# while the stored caps are missing.
DAILY_CAP_USD=5
VISITOR_DAILY_CAP_USD=0.50
VISITOR_DAILY_EDIT_LIMIT=5
VISITOR_DAILY_SAM_LIMIT=80
VISITOR_DAILY_SPARK_LIMIT=12
VISITOR_DAILY_ASR_LIMIT=3
PROJECT_HARD_CAP_USD=100
DEVELOPMENT_STOP_USD=50
TICKET_CAP_USD=5
# Local live calls are booked to this ticket (T0..T21); required before any live app call.
BUDGET_TICKET=
# development (local work) or demo (public site). Anything else turns live mode off.
# A deployment goes live only with VERCEL_ENV=production and BUDGET_PHASE=demo; switch
# to demo only after reconciling the development ledger.
BUDGET_PHASE=development

# Server allowlist for optional listing/image fetches. Exact hosts only.
# Empty means remote fetching is disabled; search links can still be shown.
PUBLIC_SHOP_DOMAINS=
