{
  "type": "object",
  "properties": {
    "results": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "verify",
              "problem"
            ]
          },
          "approval": {
            "type": "string",
            "enum": [
              "abe",
              "e_mark",
              "teilegutachten",
              "none",
              "unknown"
            ]
          },
          "documentCoverage": {
            "type": "string",
            "enum": [
              "covered",
              "not_covered",
              "unknown"
            ]
          },
          "inspection": {
            "type": "string",
            "enum": [
              "none",
              "aenderungsabnahme",
              "einzelabnahme",
              "unknown"
            ]
          },
          "eintragung": {
            "type": "string",
            "enum": [
              "required",
              "not_required",
              "unknown"
            ]
          },
          "carryDocuments": {
            "type": "string",
            "enum": [
              "required",
              "not_required",
              "unknown"
            ]
          },
          "reasons": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "toMeasure": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "extraParts": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "conditions": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "sources": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^https:\\/\\/.*"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "supports": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "url",
                "title",
                "supports"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "itemId",
          "status",
          "approval",
          "documentCoverage",
          "inspection",
          "eintragung",
          "carryDocuments",
          "reasons",
          "toMeasure",
          "extraParts",
          "conditions",
          "confidence",
          "sources"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "results"
  ],
  "additionalProperties": false
}
